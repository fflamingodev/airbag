{
  "realm": "reskin-demo",
  "displayName": "RE-SKIN (démo)",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 7200,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "clients": [
    {
      "clientId": "app-demo",
      "name": "Applications de démo (6 solutions)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3001/*",
        "http://localhost:3002/*",
        "http://localhost:3003/*",
        "http://localhost:3004/*",
        "http://localhost:3005/*",
        "http://localhost:3006/*"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost:3002",
        "http://localhost:3003",
        "http://localhost:3004",
        "http://localhost:3005",
        "http://localhost:3006"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/*##http://localhost:3002/*##http://localhost:3003/*##http://localhost:3004/*##http://localhost:3005/*##http://localhost:3006/*"
      },
      "protocolMappers": [
        {
          "name": "audience app-demo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "app-demo",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "app-demo": [
        {
          "name": "proprietaire",
          "description": "Rôle local de l'app : proprietaire"
        },
        {
          "name": "architecte",
          "description": "Rôle local de l'app : architecte"
        },
        {
          "name": "building-administrator",
          "description": "Rôle local de l'app : building-administrator"
        },
        {
          "name": "facility-manager",
          "description": "Rôle local de l'app : facility-manager"
        },
        {
          "name": "event-manager",
          "description": "Rôle local de l'app : event-manager"
        },
        {
          "name": "technicien",
          "description": "Rôle local de l'app : technicien"
        },
        {
          "name": "locataire",
          "description": "Rôle local de l'app : locataire"
        },
        {
          "name": "fabricant",
          "description": "Rôle local de l'app : fabricant"
        },
        {
          "name": "admin-plateforme",
          "description": "Rôle local de l'app : admin-plateforme"
        }
      ]
    }
  },
